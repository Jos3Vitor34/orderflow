# Public configuration only. Secret values belong in mounted files, never here.
# Copy to .env.production and replace the image tag with the exact commit SHA.
IMAGE_TAG=replace-with-commit-sha
SECRETS_DIR=./.secrets
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
CORS_ORIGINS=https://orderflow.example.invalid
CELERY_CONCURRENCY=2
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Only for compose.https.yaml; supply an authorized domain and valid certificate.
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
TLS_CERTIFICATE_FILE=./.certs/fullchain.pem
TLS_PRIVATE_KEY_FILE=./.certs/privkey.pem
