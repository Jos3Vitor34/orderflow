POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://orderflow:orderflow_password@localhost:5432/orderflow
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
CELERY_LOG_LEVEL=INFO
# Required by the API. Generate a unique random value with at least 32 characters.
# Never reuse this example value outside a disposable local environment.
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
# Lifetime of an access token. Refresh tokens are intentionally not supported.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Stripe Test Mode only. Never commit a real secret key.
STRIPE_SECRET_KEY=
# Stripe webhook endpoint/CLI signing secret. Never commit a real value.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl
